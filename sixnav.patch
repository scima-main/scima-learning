-  const parts = [];
-  try {
-    for (const item of spine) {
-      try {
-        const result = await epub.loadChapter(item.id); // returns { html, css }
-        parts.push({ id: item.id, text: htmlToPlainText(result.html || ''), html: result.html || '' });
