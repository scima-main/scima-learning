-      const src = (!isFront && card.citation) ? (state.sources||[]).find(s => s.id === card.citation?.sourceId) : null;
-      const chap = (src && card.citation?.chapterId) ? src.chapters?.find(ch => ch.id === card.citation.chapterId) : null;
