diff --git a/minified/backend/tests/test_api.py b/minified/backend/tests/test_api.py
index 68e79d4..1b45f9e 100644
--- a/minified/backend/tests/test_api.py
+++ b/minified/backend/tests/test_api.py
@@ -590,3 +590,16 @@ def test_html_asset_urls_carry_version_stamp(client):
     # external URLs untouched
     assert 'fonts.googleapis.com/css2?family=Nunito' in client.get("/").text
     assert '?v=' not in client.get("/").text.split('fonts.googleapis.com')[1].split('"')[0]
+
+
+def test_legacy_community_path_redirects_to_landing_view(client):
+    """The deprecated standalone shell must never be served again: /community
+    and /community/ 302 to the landing document's #community view."""
+    for path in ("/community", "/community/"):
+        r = client.get(path, follow_redirects=False)
+        assert r.status_code == 302, path
+        assert r.headers["location"] == "/#community", path
+    # deep legacy links keep working through the 404 rewrite
+    r = client.get("/community/sd_abc123", follow_redirects=False)
+    assert r.status_code == 302
+    assert r.headers["location"] == "/#community/sd_abc123"
diff --git a/minified/home/ABOUT.md b/minified/home/ABOUT.md
index 0db41bd..357fed1 100644
--- a/minified/home/ABOUT.md
+++ b/minified/home/ABOUT.md
@@ -1,5 +1,14 @@
 # CHANGELOG (last updated 24th October 2026, UTC)
 
+#### VERSION 2026.10.31-ALPHA	
+
+- Fixed: Home/Community navigation could stick on the wrong document when a cached copy served a page at the wrong URL — every page now carries a tiny inline url-sanity guard that relocates a mis-served document before its relative assets 404
+- /community/ no longer serves the dead legacy shell: it redirects to the live Community view (/#community); deep links like /community/<deck-id> keep working
+
+#### VERSION 2026.10.30-ALPHA	
+
+- Fixed: from a route page (e.g. Decks), opening Home or Community could stick on the wrong document (/decks/#home, or an empty “community” hash) whenever the inline page declaration was missing from a stale cached document — the relative root is now sniffed from the route, and navigate() double-checks that the target view's container exists in this document before treating a jump as in-page
+
 #### VERSION 2026.10.29-ALPHA	
 
 - Fixed: ordinary reloads (Ctrl+R) could lose the icon sprites, the changelog and the page declaration while a hard reload (Ctrl+Shift+R) worked.
