    { "click": "#page-tabs .tab-btn[data-view='quests']" },
    { "wait_for": { "selector": "#view-quests" } },
    { "pause": 700 },
    { "assert": { "url_contains": "#quests" } }
  ],
  "output": "screenshots/06-analytics-quests.png",
  "full_page": true
}
