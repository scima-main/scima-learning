{
  "name": "analytics-quests",
  "description": "Analytics with 9 days of seeded history, then the merged Quests tab.",
  "seed": "preset:demo",
  "steps": [
    { "goto": "/analytics/" },
    { "wait_for": { "selector": ".heatmap" } },
